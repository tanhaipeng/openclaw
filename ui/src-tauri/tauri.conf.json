{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw Control",
  "version": "0.1.0",
  "identifier": "ai.openclaw.control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist/control-ui"
  },
  "app": {
    "windows": [
      {
        "title": "OpenClaw Control",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] },
  "plugins": {}
}
